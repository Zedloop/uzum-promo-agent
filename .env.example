# Uzum Seller API (ichki/norasmiy - DevTools orqali aniqlangan)
UZUM_API_BASE_URL=https://api-seller.uzum.uz/api/seller

# Tavsiya etiladi: login/parol beriladi, token avtomatik o'zi yangilanadi.
UZUM_USERNAME=your_uzum_seller_email_here
UZUM_PASSWORD=your_uzum_seller_password_here

# Zaxira variant: login/parol berilmasa, shu yerga qo'lda olingan sessiya
# tokenini qo'yish mumkin.
UZUM_API_KEY=your_uzum_session_token_here

# Bir nechta do'kon bo'lsa, vergul bilan ajrating: 111,222,333
UZUM_SHOP_IDS=your_shop_id_1,your_shop_id_2,your_shop_id_3

# Telegram Bot (@BotFather orqali yaratiladi)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ERP SQLite bazasining yo'li (serverda ERP bilan bir xil joyda bo'lishi kerak)
ERP_DB_PATH=/home/youruser/erp-app/erp.db

# /run-check manzilini tashqaridan (cron-job.org) chaqirish uchun maxfiy token
RUN_TOKEN=generate_a_random_secret_here
